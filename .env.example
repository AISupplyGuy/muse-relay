# Postgres connection string (Neon pooled URL recommended). Required.
DATABASE_URL=
# Key Muse sends as "Authorization: Bearer <key>" on /api/v1/*. Required.
MUSE_KEY=
# Key the Grok agent sends as "Authorization: Bearer <key>" on /mcp. Required.
GROK_KEY=
# Shared secret used to HMAC-sign webhook calls (X-Relay-Signature). Required if GROK_WEBHOOK_URL is set.
WEBHOOK_SECRET=
# Optional: URL that receives a POST for each new Muse message. Empty = no push.
GROK_WEBHOOK_URL=
# Optional: sent verbatim as the Authorization header on webhook calls, e.g. "Bearer abc123".
GROK_WEBHOOK_AUTH=
# Optional: max decoded attachment bytes per message (default 3145728 = 3 MB).
MAX_FILE_BYTES=
# Optional: total attachment storage cap in bytes (default 419430400 = 400 MB).
MAX_TOTAL_STORAGE_BYTES=
# Optional: DB poll interval during long-polls (default 1500 ms).
POLL_INTERVAL_MS=
# Optional: override the base URL shown in /docs and /openapi.json.
PUBLIC_BASE_URL=
